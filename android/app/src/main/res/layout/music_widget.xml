<?xml version="1.0" encoding="utf-8"?>
<!-- Album art blurred behind a dark scrim, a large rounded cover, light type, thin white progress and a
     round white play button between quiet prev / next icons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/music_widget_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/mw_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/music_widget_scrim" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="16dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/mw_art" android:layout_width="68dp" android:layout_height="68dp"
                android:scaleType="centerCrop" android:background="@drawable/music_widget_art_bg"
                android:src="@mipmap/ic_launcher" android:contentDescription="@null" android:clipToOutline="true" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                    android:singleLine="true" android:ellipsize="end" android:text="Trình phát nhạc" />
                <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textColor="#A6FFFFFF" android:textSize="13sp"
                    android:singleLine="true" android:ellipsize="end" android:text="Chưa phát nhạc" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/mw_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="12dp"
            android:max="1000" android:progress="0" android:progressDrawable="@drawable/music_widget_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="4dp"
            android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/mw_prev" android:layout_width="56dp" android:layout_height="48dp"
                android:background="@null" android:src="@drawable/ic_w_prev" android:alpha="0.9" android:contentDescription="Bài trước" />
            <ImageButton android:id="@+id/mw_play" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:padding="13dp" android:scaleType="fitCenter"
                android:background="@drawable/music_widget_play_bg" android:src="@drawable/ic_w_play" android:contentDescription="Phát hoặc tạm dừng" />
            <ImageButton android:id="@+id/mw_next" android:layout_width="56dp" android:layout_height="48dp"
                android:background="@null" android:src="@drawable/ic_w_next" android:alpha="0.9" android:contentDescription="Bài sau" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
