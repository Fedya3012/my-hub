<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/music_widget_bg">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/mw_art" android:layout_width="64dp" android:layout_height="64dp"
            android:scaleType="centerCrop" android:background="@drawable/music_widget_art_bg"
            android:src="@mipmap/ic_launcher" android:contentDescription="@null" android:clipToOutline="true" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:singleLine="true" android:ellipsize="end" android:text="Trình phát nhạc" />
            <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#BFFFFFFF" android:textSize="13sp"
                android:singleLine="true" android:ellipsize="end" android:text="Chưa phát nhạc" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/mw_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
        android:max="1000" android:progress="0" android:progressDrawable="@drawable/music_widget_progress" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@+id/mw_prev" android:layout_width="56dp" android:layout_height="48dp"
            android:background="@null" android:src="@android:drawable/ic_media_previous" android:contentDescription="Bài trước" />
        <ImageButton android:id="@+id/mw_play" android:layout_width="72dp" android:layout_height="48dp"
            android:background="@null" android:src="@android:drawable/ic_media_play" android:contentDescription="Phát hoặc tạm dừng" />
        <ImageButton android:id="@+id/mw_next" android:layout_width="56dp" android:layout_height="48dp"
            android:background="@null" android:src="@android:drawable/ic_media_next" android:contentDescription="Bài sau" />
    </LinearLayout>
</LinearLayout>
